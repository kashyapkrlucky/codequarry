# ── Database (required) ───────────────────────────────────────────────
# Neon pooled connection string (Neon console → Connect → "Pooled connection").
# Server-only: never prefix with NEXT_PUBLIC_.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Optional: direct (non-pooled) URL for Prisma migrations.
# If omitted, it is derived from DATABASE_URL by removing "-pooler".
# DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# ── Site ──────────────────────────────────────────────────────────────
# Canonical origin used for metadata, sitemap and Open Graph URLs.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Cache revalidation after content import (optional) ────────────────
# Shared secret for POST /api/revalidate. Generate with: openssl rand -hex 32
REVALIDATE_SECRET=""
# Set to your deployment's endpoint to refresh pages after `npm run content:import`.
# REVALIDATE_URL="https://codequarry.vercel.app/api/revalidate"
